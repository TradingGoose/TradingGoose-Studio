# Database (Required)
DATABASE_URL="postgres://postgres:postgres@db:5432/tradinggoose"

# PostgreSQL Port (Optional) - defaults to 5432 if not specified
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradinggoose
POSTGRES_PORT=5432

# Authentication (Required)
# Use `openssl rand -hex 32` to generate, or visit https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=generate-the-secret  
BETTER_AUTH_URL=http://localhost:3000

# NextJS (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-accessible socket URL for local Compose runs; override it for production.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# Docker image tags (Required for compose manifests that pull published images)
IMAGE_TAG=latest
OLLAMA_IMAGE_TAG=latest

# Security (Required)
# Use `openssl rand -hex 32` to generate, used to encrypt environment variables
ENCRYPTION_KEY=generate-the-key  
# Optional unless API-key access or MCP token issuance is used.
# Use `openssl rand -hex 32` to generate, used to encrypt API keys
API_ENCRYPTION_KEY=
# Use `openssl rand -hex 32` to generate, used to encrypt internal api routes
INTERNAL_API_SECRET=generate-the-secret  

# Configure generic runtime service credentials in Admin Services.
# Workflow model keys are entered/referenced in the workflow. Native Mastra
# connections use its documented provider configuration. Native storage requires
# a scoped MASTRA_DATABASE_URL; deployment-only native:init performs ordinary DDL.
# Configure integration OAuth apps in Admin Integrations.

# Google social sign-in (Optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

REDIS_URL=redis://redis:6379

# Workflow archives use a separately verified private destination. No public upload fallback.
# Set true only after destination ACLs and prior archive URL revocation are verified.
WORKFLOW_ARCHIVE_PRIVATE_VERIFIED=false
# WORKFLOW_ARCHIVE_PROVIDER=local
# WORKFLOW_ARCHIVE_LOCAL_ROOT=/var/lib/tradinggoose/private-workflow-archives
# WORKFLOW_ARCHIVE_S3_BUCKET=
# WORKFLOW_ARCHIVE_S3_REGION=
# WORKFLOW_ARCHIVE_AZURE_CONTAINER=
# WORKFLOW_ARCHIVE_AZURE_ACCOUNT=
# WORKFLOW_ARCHIVE_AZURE_KEY=
# WORKFLOW_ARCHIVE_AZURE_CONNECTION_STRING=
# WORKFLOW_ARCHIVE_VERCEL_TOKEN=
# WORKFLOW_ARCHIVE_VERCEL_ORIGIN=

# Ordinary native storage: same primary, scoped runtime role; owner URL is deployment-only.
MASTRA_DATABASE_URL=
MASTRA_OWNER_DATABASE_URL=
# Enable only after indexes and authenticated recurring dispatch are verified.
BILLING_DISPATCH_READY=false
